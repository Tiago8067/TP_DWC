@page "/clientes"
@using Tp_DWC.Shared.Models
@using Tp_DWC.Shared.Services.ClienteService

<h3>Lista de Clientes</h3>

<a href="@($"ClienteDetalhes")" class="btn btn-outline-success" style="width: 100%;">
    Adicionar um Novo Cliente
</a>

<br />

<Tp_DWC.Shared.Components.ComponentTable 
    Items="clientes" 
    Headers="headers"
    Columns="columns"
    EditCallback="EditClienteCallback"
    AdditionalButtons="RenderAdditionalButtons"></Tp_DWC.Shared.Components.ComponentTable>

<Tp_DWC.Shared.Components.ComponentModal Title="Detalhes do Cliente" IsOpen="IsModalOpen" OnClose="CloseModal">
    <BodyContent>
        @if (SelectedCliente != null)
        {
            <p><strong>Nome:</strong> @SelectedCliente.Nome</p>
            <p><strong>Website:</strong> @SelectedCliente.Website</p>
            <p><strong>Ativo:</strong> @(SelectedCliente.Ativo ? "Sim" : "Não")</p>
        }
    </BodyContent>
</Tp_DWC.Shared.Components.ComponentModal>


@code {
    [Inject]
    private IClienteService ClienteService { get; set; }

    public IEnumerable<Cliente> clientes { get; set; } = new List<Cliente>();

    protected async override Task OnInitializedAsync()
    {
        var apiClientes = await ClienteService.AllClientes();

        if (apiClientes != null && apiClientes.Any())
        {
            clientes = apiClientes;
        }
    }

    public List<string> headers { get; set; } = new List<string> { "Nome", "Website", "Ativo" };
    public List<Func<object, object>> columns { get; set; } = new List<Func<object, object>>
    {
        item => ((Cliente)item).Nome,
        item => ((Cliente)item).Website,
        item => ((Cliente)item).Ativo ? "Sim" : "Não"
    };
    private string EditClienteCallback(object item)
    {
        if (item is Cliente cliente)
        {
            return $"ClienteDetalhes/{cliente.PK_Cliente}";
        }
        return "#";
    }

    public Cliente SelectedCliente { get; set; }
    public bool IsModalOpen { get; set; } = false;
    private void OpenModal(object item)
    {
        if (item is Cliente cliente)
        {
            SelectedCliente = cliente;
            IsModalOpen = true;
        }
    }

    private void CloseModal()
    {
        IsModalOpen = false;
        SelectedCliente = null;
    }

    private RenderFragment<object> RenderAdditionalButtons => item => __builder =>
    {
        __builder.OpenElement(0, "button");
        __builder.AddAttribute(1, "class", "btn btn-info ms-2");
        __builder.AddAttribute(2, "onclick", EventCallback.Factory.Create(this, () => OpenModal(item)));
        __builder.AddContent(3, "Ver Detalhes");
        __builder.CloseElement();
    };
}
