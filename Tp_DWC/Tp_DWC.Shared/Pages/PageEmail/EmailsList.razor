@using Tp_DWC.Shared.Models

<h3>Emails do Cliente</h3>

<a href="@($"/emaildetalhes/{clientePk}")" class="btn btn-outline-success">
    Adicionar um Novo Email
    </a>

<br />

<Tp_DWC.Shared.Components.ComponentTable Items="emails"
    Headers="headers"
    Columns="columns"
    EditCallback="EditClienteCallback"
    AdditionalButtons="RenderAdditionalButtons">
</Tp_DWC.Shared.Components.ComponentTable>

<Tp_DWC.Shared.Components.ComponentModal Title="Detalhes do Email" IsOpen="IsModalOpen" OnClose="CloseModal">
    <BodyContent>
        @if (SelectedEmail != null)
        {
            <p><strong>Tipo Email:</strong> @SelectedEmail.TipoEmail</p>
            <p><strong>Endereço Email:</strong> @SelectedEmail.EnderecoEmail</p>
        }
    </BodyContent>
</Tp_DWC.Shared.Components.ComponentModal>

@code {
    [Parameter]
    public List<Email> emails { get; set; }

    [Parameter]
    public string clientePk { get; set; }

    protected async override Task OnInitializedAsync()
    {
    }

    public List<string> headers { get; set; } = new List<string> { "Tipo", "Email" };
    public List<Func<object, object>> columns { get; set; } = new List<Func<object, object>>
    {
        item => ((Email)item).TipoEmail,
        item => ((Email)item).EnderecoEmail
    };
    private string EditClienteCallback(object item)
    {
        if (item is Email email)
        {
            return $"/emaildetalhes/{email.ClienteId}/{email.PK_Email}";
        }
        return "#";
    }

    public Email SelectedEmail { get; set; }
    public bool IsModalOpen { get; set; } = false;
    private void OpenModal(object item)
    {
        if (item is Email email)
        {
            SelectedEmail = email;
            IsModalOpen = true;
        }
    }

    private void CloseModal()
    {
        IsModalOpen = false;
        SelectedEmail = null;
    }

    private RenderFragment<object> RenderAdditionalButtons => item => __builder =>
    {
        __builder.OpenElement(0, "button");
        __builder.AddAttribute(1, "class", "btn btn-info ms-2");
        __builder.AddAttribute(2, "onclick", EventCallback.Factory.Create(this, () => OpenModal(item)));
        __builder.AddContent(3, "Ver Detalhes");
        __builder.CloseElement();
    };
}
