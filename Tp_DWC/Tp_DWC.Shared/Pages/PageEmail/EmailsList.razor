@using Tp_DWC.Shared.Models

<h3>Emails do Cliente</h3>

<a href="@($"MoradasDetalhes")" class="btn btn-success">Adicionar um Novo Email</a>

<br />

<Tp_DWC.Shared.Components.ComponentTable Items="emails"
    Headers="headers"
    Columns="columns"
    EditCallback="EditClienteCallback"
    AdditionalButtons="RenderAdditionalButtons">
</Tp_DWC.Shared.Components.ComponentTable>

