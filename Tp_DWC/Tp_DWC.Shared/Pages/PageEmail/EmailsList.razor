@code {
    [Parameter]
    public List<Email> emails { get; set; }

    protected async override Task OnInitializedAsync()
    {
    }

    public List<string> headers { get; set; } = new List<string> { "Tipo", "Email" };
    public List<Func<object, object>> columns { get; set; } = new List<Func<object, object>>
    {
        item => ((Email)item).TipoEmail,
        item => ((Email)item).EnderecoEmail
    };
    private string EditClienteCallback(object item)
    {
        if (item is Email email)
        {
            return "#";
            //return $"ClienteDetalhes/{morada.ClienteId}/moradasdetalhes/{morada.PK_Morada}";
        }
        return "#";
    }

    public Email SelectedEmail { get; set; }
    public bool IsModalOpen { get; set; } = false;
    private void OpenModal(object item)
    {
        if (item is Email email)
        {
            SelectedEmail = email;
            IsModalOpen = true;
        }
    }

    private void CloseModal()
    {
        IsModalOpen = false;
        SelectedEmail = null;
    }

