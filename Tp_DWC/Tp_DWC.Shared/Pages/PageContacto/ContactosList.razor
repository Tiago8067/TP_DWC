@using Tp_DWC.Shared.Models

<h3>Contactos do Cliente</h3>

<a href="@($"/contactodetalhes/{clientePk}")" class="btn btn-outline-success">
	Adicionar um Novo Contacto
</a>

<br />

<Tp_DWC.Shared.Components.ComponentTable Items="contactos"
										 Headers="headers"
										 Columns="columns"
										 EditCallback="EditClienteCallback"
										 AdditionalButtons="RenderAdditionalButtons">
</Tp_DWC.Shared.Components.ComponentTable>

<Tp_DWC.Shared.Components.ComponentModal Title="Detalhes do Contacto" IsOpen="IsModalOpen" OnClose="CloseModal">
	<BodyContent>
		@if (SelectedContacto != null)
		{
			<p><strong>Tipo Contacto:</strong> @SelectedContacto.TipoContacto</p>
			<p><strong>Número:</strong> @SelectedContacto.Numero</p>
		}
	</BodyContent>
</Tp_DWC.Shared.Components.ComponentModal>

@code {
	[Parameter]
	public List<Contacto> contactos { get; set; }

	[Parameter]
	public string clientePk { get; set; }

	protected async override Task OnInitializedAsync()
	{
	}

	public List<string> headers { get; set; } = new List<string> { "Tipo de Contacto", "Numero" };
	public List<Func<object, object>> columns { get; set; } = new List<Func<object, object>>
	{
		item => ((Contacto)item).TipoContacto,
		item => ((Contacto)item).Numero
	};
	private string EditClienteCallback(object item)
	{
		if (item is Contacto contacto)
		{
			return $"/contactodetalhes/{contacto.ClienteId}/{contacto.PK_Contacto}";
		}
		return "#";
	}

	public Contacto SelectedContacto { get; set; }
	public bool IsModalOpen { get; set; } = false;
	private void OpenModal(object item)
	{
		if (item is Contacto contacto)
		{
			SelectedContacto = contacto;
			IsModalOpen = true;
		}
	}

	private void CloseModal()
	{
		IsModalOpen = false;
		SelectedContacto = null;
	}

	private RenderFragment<object> RenderAdditionalButtons => item => __builder =>
	{
		__builder.OpenElement(0, "button");
		__builder.AddAttribute(1, "class", "btn btn-info ms-2");
		__builder.AddAttribute(2, "onclick", EventCallback.Factory.Create(this, () => OpenModal(item)));
		__builder.AddContent(3, "Ver Detalhes");
		__builder.CloseElement();
	};
}
