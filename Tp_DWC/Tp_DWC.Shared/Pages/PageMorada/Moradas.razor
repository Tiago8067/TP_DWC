    public List<string> headers { get; set; } = new List<string> { "País", "Localidade", "Código Postal", "Tipo de Morada" };
    public List<Func<object, object>> columns { get; set; } = new List<Func<object, object>>
    {
        item => ((Morada)item).Pais,
        item => ((Morada)item).Localidade,
        item => ((Morada)item).CodigoPostal,
        item => ((Morada)item).TipoMorada
    };
    private string EditClienteCallback(object item)
    {
        if (item is Morada morada)
        {
            return "#";
            //return $"ClienteDetalhes/{morada.ClienteId}/moradasdetalhes/{morada.PK_Morada}";
        }
        return "#";
    }

    public Morada SelectedMorada { get; set; }
    public bool IsModalOpen { get; set; } = false;
    private void OpenModal(object item)
    {
        if (item is Morada morada)
        {
            SelectedMorada = morada;
            IsModalOpen = true;
        }
    }

    private void CloseModal()
    {
        IsModalOpen = false;
        SelectedMorada = null;
    }

