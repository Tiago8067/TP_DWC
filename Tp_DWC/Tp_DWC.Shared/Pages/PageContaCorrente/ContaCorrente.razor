@page "/contacorrente"
@page "/contacorrente/{clientePk}/{nomeCliente}"
@using Tp_DWC.Shared.Models
@using Tp_DWC.Shared.Services.AssistenciaService
@inject IAssistenciaService AssistenciaService
@inject NavigationManager NavigationManager

<div class="d-flex justify-content-between align-items-center">
    <h3>Conta Corrente (assistências por pagar)</h3>
    <button type="button" class="btn btn-primary" @onclick="GoBack">Voltar Atrás</button>
</div>
<br />

@if (!string.IsNullOrEmpty(nomeCliente))
{
    <p><strong>Número do Cliente:</strong> @clientePk</p>
    <p><strong>Nome do Cliente:</strong> @nomeCliente</p>
}

