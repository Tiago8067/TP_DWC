@if (list != null && list.Any())
{
    <div class="row">
        @foreach (var item in list)
        {
            var parts = item.Split('|');
            var numeroInterno = parts.Length > 0 ? parts[0].Trim() : "";
            var dataCriacao = parts.Length > 1 ? parts[1].Trim() : "";
            var dataConclusao = parts.Length > 2 ? parts[2].Trim() : "";
            <div class="col-md-4 mb-3">
                <div class="card">
                    <div class="card-body">
                        <p class="card-text"><strong>Número Interno:</strong> @numeroInterno</p>
                        <p class="card-text"><strong>Data de Registo:</strong> @dataCriacao</p>
                        <p class="card-text"><strong>Data de Conclusão:</strong> @dataConclusao</p>
                    </div>
                </div>
            </div>
        }
    </div>
}

else
{
    <p>Nenhuma conta corrente encontrada.</p>
}

<br />
<p style="color: red;">@Message</p>

@code {
    private string Message = string.Empty;
    [Parameter]
    public string clientePk { get; set; }

    [Parameter]
    public string nomeCliente { get; set; }

    [Parameter]
    public List<string>? list { get; set; }

    protected async override Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(clientePk))
        {
            Guid pkEstado = Guid.Parse("66666666-6666-6666-6666-666666666666");
            Guid idCliente = Guid.Parse(clientePk);
            // Guid pkEstado = Guid.Parse("11111111-1111-1111-1111-111111111111");
            var result = await AssistenciaService.GetContaCorrente(pkEstado, idCliente);
			if (result != null)
			{
				list = result;
			}
			else
			{
				Message = "Conta Corrente não encontrada.";
			}
		}
		else
		{
			Message = "Cliente não informado.";
		}
	}

    private void GoBack()
    {
        NavigationManager.NavigateTo($"/clientedetalhes/{clientePk}");
    }

}
